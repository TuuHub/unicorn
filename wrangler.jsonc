{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unicorn",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-12",
  // global_fetch_strictly_public: every outbound fetch goes to the public internet, never a
  // private/internal address — required for OAuth CIMD and a baseline SSRF guard for manifest plugins.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULER",
        "class_name": "Scheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Scheduler"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AgentSession"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["AgentSession"]
    }
  ],
  "vars": {
    "MOODLE_BASE_URL": "https://learning.monash.edu"
  },
  // OAuth authorization-server storage for connectors (ADR-0035, src/oauth-server.ts). No id:
  // wrangler >=4.45 auto-provisions and binds a KV namespace with this name on `wrangler deploy`
  // (and locally on `wrangler dev`), so `npm run upgrade` picks this up on an existing production
  // deploy with no manual `wrangler kv namespace create` step.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unicorn",
      "database_id": "1d643c3d-effa-4675-ad8b-2f5af97aa855",
      "migrations_dir": "migrations"
    }
  ]
}
