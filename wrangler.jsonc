{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unicorn",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULER",
        "class_name": "Scheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Scheduler"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AgentSession"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["AgentSession"]
    }
  ],
  "vars": {
    "MOODLE_BASE_URL": "https://learning.monash.edu"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unicorn",
      "database_id": "1d643c3d-effa-4675-ad8b-2f5af97aa855",
      "migrations_dir": "migrations"
    }
  ]
}
