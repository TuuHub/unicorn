{
  "name": "unicorn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^5.10.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "check": "tsc --noEmit && vitest run",
    "db:migrate": "wrangler d1 migrations apply unicorn --remote",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "moodle:push": "node scripts/push-moodle-session.mjs",
    "setup": "node scripts/setup.mjs",
    "upgrade": "wrangler d1 migrations apply unicorn --remote && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260712.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.110.0"
  }
}
